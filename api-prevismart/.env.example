# Banco PostgreSQL local. Substitua a senha de exemplo no arquivo .env real.
DATABASE_URL=postgres://prevismart_user:replace_with_local_password@localhost:5432/prevismart

# Endereço e porta locais da API.
APP_HOST=127.0.0.1
APP_PORT=3000

# Origem de desenvolvimento de um cliente local; ajuste para o consumidor em uso.
CORS_ALLOWED_ORIGIN=http://localhost:5173
